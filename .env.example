# ─────────────────────────────────────────────────────────────
# LeetSense environment variables — copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---
# Local docker default, or a Neon connection string
DATABASE_URL="postgresql://leetsense:leetsense@localhost:5432/leetsense?schema=public"

# --- Auth (JWT) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# --- Redis (BullMQ queue) ---
REDIS_URL="redis://localhost:6379"

# --- Google Gemini (chatbot + embeddings) ---
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# --- ChromaDB (vector store) ---
CHROMA_URL="http://localhost:8000"
# Optional Chroma Cloud creds (leave blank for local)
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- LeetCode (authenticated GraphQL access) ---
# Grab these from your browser cookies on leetcode.com after logging in
LEETCODE_SESSION=""
LEETCODE_CSRF=""

# --- App ---
BACKEND_PORT="3000"
FRONTEND_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3001"
