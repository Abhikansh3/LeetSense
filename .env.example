# ─────────────────────────────────────────────────────────────
# LeetSense environment variables — copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---
# Local docker default (host port 5433 to avoid clashing with a native
# Postgres on 5432), or a Neon connection string
DATABASE_URL="postgresql://leetsense:leetsense@localhost:5433/leetsense?schema=public"

# --- Auth (JWT) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
# SameSite policy for the refresh cookie. Unset it follows the deployment:
# "lax" in development, "none" in production, where the frontend and API are
# on different domains and a Lax cookie would never be sent. Set to "lax" only
# if both are served from one domain.
# COOKIE_SAMESITE="lax"

# --- Redis (BullMQ queue + dashboard stats cache) ---
REDIS_URL="redis://localhost:6379"

# Read-through cache over the /api/stats aggregations, invalidated whenever a
# sync completes. Set CACHE_ENABLED=false to measure the uncached baseline
# (see `pnpm --filter @leetsense/backend bench`).
CACHE_ENABLED="true"
STATS_CACHE_TTL="300"

# --- Google Gemini (chatbot + embeddings) ---
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-001"

# --- ChromaDB (vector store) ---
CHROMA_URL="http://localhost:8000"
# Optional Chroma Cloud creds (leave blank for local)
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- LeetCode (authenticated GraphQL access) ---
# Grab these from your browser cookies on leetcode.com after logging in.
# NOTE: this cookie only unlocks FULL history for the account it belongs to.
# Every other user is synced from LeetCode's public per-user endpoint, which
# returns roughly the 20 most recent accepted submissions.
LEETCODE_SESSION=""
LEETCODE_CSRF=""

# --- App ---
BACKEND_PORT="3000"
FRONTEND_PORT="3001"
# Run the sync worker inside the API process. Unset = on in development,
# off in production (where docker-compose runs a dedicated worker service).
# WORKER_IN_PROCESS="true"
NEXT_PUBLIC_API_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3001"

# Encrypts users' stored LeetCode session cookies at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- RAG eval harness (`pnpm eval run`, packages/eval) ---
# Only needed to grade the assistant; the app runs fine without any of these.
EVAL_API_URL="http://localhost:3000"

# The account the eval questions are asked about. It must ALREADY have synced
# LeetCode data — against a fresh account every answer is honestly "no data
# yet" and the whole run grades WRONG. /api/chat takes a Bearer token only, so
# the harness logs in with these to get one.
EVAL_USER_EMAIL=""
EVAL_USER_PASSWORD=""

# The judge must not be the answering model — a model grading its own output
# agrees with itself far more than it should. Answering is whatever the backend
# has in GEMINI_CHAT_MODEL above; EVAL_ANSWER_MODEL is only recorded in the
# report for provenance, since a harness that consumes the API cannot override
# it. Keep the two in sync by hand or the report will name the wrong model.
EVAL_ANSWER_MODEL="gemini-2.5-flash"
EVAL_JUDGE_MODEL="gemini-2.5-pro"

# Pacing, applied to live calls only — cache hits are free and unthrottled.
EVAL_RAG_RATE_MS="1000"
EVAL_JUDGE_RATE_MS="2000"

# k for recall@k. Retrieval is hardcoded to the top 6 chunks in queryChunks,
# so raising this above 6 cannot help.
EVAL_RECALL_K="5"

# Grades below this confidence are printed with a REVIEW marker and listed in
# the report for hand-checking.
EVAL_LOW_CONFIDENCE="0.7"
