{
  "name": "leetsense",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered LeetCode analytics platform with RAG-based insights",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @leetsense/db db:generate",
    "db:migrate": "pnpm --filter @leetsense/db db:migrate",
    "db:push": "pnpm --filter @leetsense/db db:push",
    "db:studio": "pnpm --filter @leetsense/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
